# Generate a strong token with: openssl rand -hex 32
# Required: Bearer token for authenticating client requests
MCP_AUTH_TOKEN=change-me-to-a-secure-random-token

# Optional: Path to SQLite database file (default: data/notes.db)
DB_PATH=data/notes.db

# Optional: Host address to bind the server to (default: 0.0.0.0)
HOST=0.0.0.0

# Optional: Port number to listen on (default: 3000)
PORT=3000

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR) (default: INFO)
LOG_LEVEL=INFO

# Optional: Comma-separated list of allowed hostnames/domains for reverse proxy protection (default: none)
ALLOWED_HOSTS=*
